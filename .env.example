# Copy this file to `.env` and fill in your own Alpaca paper trading
# credentials (never commit the real `.env` — it's already gitignored).
# Get paper trading keys from https://app.alpaca.markets/paper/dashboard/overview

APCA_API_KEY_ID=your-paper-key-id
APCA_API_SECRET_KEY=your-paper-secret-key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Postgres connection string for trade telemetry logging
# (src/utils/db.py). Required for src.trading.alpaca_execution to record
# executed trades; the rest of the app works fine without it.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Upstash Redis REST credentials (src/utils/cache.py), used to cache slow
# / rate-limited yfinance calls (financial statements, historical
# prices). Optional — if unset, caching is simply disabled and every
# call hits yfinance directly. Get these from your database's page at
# https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
