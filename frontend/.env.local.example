# Copy this file to `.env.local` in this directory (never commit the
# real `.env.local` — it's already gitignored).
#
# Next.js only loads env files from THIS directory, not the root
# project's `.env` — the Python backend and this frontend are separate
# processes and each need their own copy of DATABASE_URL pointing at the
# same Postgres database.

DATABASE_URL=postgresql://user:password@host:5432/dbname
