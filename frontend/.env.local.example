# Copy this file to `.env.local` in this directory (never commit the
# real `.env.local` — it's already gitignored).
#
# Next.js only loads env files from THIS directory, not the root
# project's `.env` — the Python backend and this frontend are separate
# processes and each need their own copy of DATABASE_URL pointing at the
# same Postgres database.

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Upstash Redis REST credentials (frontend/src/lib/redis.ts). Used for
# two DIFFERENT purposes with different optionality:
#   1. Caching /api/backtest and /api/sentiment/[symbol] responses
#      (same Upstash database as the Python backend's
#      UPSTASH_REDIS_REST_URL/TOKEN in the root .env) — genuinely
#      optional; if unset, caching is simply disabled.
#   2. The login rate limiter (frontend/src/app/login/actions.ts). This
#      is NOT optional in production: if Redis is unconfigured or
#      unreachable there, login FAILS CLOSED (every login attempt is
#      rejected) unless LOGIN_RATE_LIMIT_FAIL_OPEN=true is explicitly
#      set below. Outside production, an unavailable rate limiter fails
#      OPEN (login proceeds unthrottled) so local development doesn't
#      require Upstash to be configured at all.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Intentionally named emergency override for the login rate limiter
# (frontend/src/app/login/actions.ts, frontend/src/lib/rate-limit-policy.ts).
# In PRODUCTION, an unavailable rate limiter (Redis unconfigured or
# erroring) fails CLOSED by default — every login attempt is rejected
# rather than silently letting brute-force protection go dark. Set this
# to exactly "true" to instead fail OPEN in production (accept the
# availability risk of unthrottled login over the availability risk of
# blocked login) — leave unset otherwise. Has no effect outside
# production, where the rate limiter already always fails open.
LOGIN_RATE_LIMIT_FAIL_OPEN=false

# Same Alpaca PAPER TRADING credentials as the root .env — used by
# /api/positions, which calls Alpaca's REST API directly to show the
# live portfolio allocation view.
APCA_API_KEY_ID=your-paper-key-id
APCA_API_SECRET_KEY=your-paper-secret-key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# This dashboard has no user accounts — a single shared passphrase gates
# every page and API route (see src/lib/auth.ts, src/proxy.ts). Generate
# SESSION_SECRET with e.g. `openssl rand -base64 32`; it signs the
# session cookie and must be a long random value, not something
# memorable. DASHBOARD_PASSWORD is whatever passphrase you want to log
# in with (12+ characters — e.g. a few random words). Both are validated
# at first use (src/lib/secret-validation.ts) — format/placeholder/
# length checks only, NOT an entropy or strength measurement: must be
# set; must not be whitespace-only or padded with leading/trailing
# whitespace; must not still be the literal placeholder value shown
# below; must not be a single character repeated to reach the length
# requirement; and must meet a minimum length (32 characters for
# SESSION_SECRET, 12 for DASHBOARD_PASSWORD) — the app refuses to start
# a session/verify a login otherwise.
SESSION_SECRET=replace-with-a-long-random-value
DASHBOARD_PASSWORD=choose-a-passphrase

# Base URL of the Python FastAPI backend (src/api/main.py) that
# /api/evaluate/[ticker] proxies to server-side. Defaults to
# http://localhost:8000 outside production if unset; PRODUCTION has NO
# safe default and must set this explicitly to the backend's real
# origin. Validated by src/lib/valuation-api-url.ts before every request:
# HTTPS is required in production (a loopback address is rejected
# there); a bare loopback HTTP origin is the one exception permitted
# outside production, for local dev against `uvicorn --reload`; no
# embedded credentials, fragment, path, or query string are accepted —
# this must be a bare origin.
VALUATION_API_URL=http://localhost:8000

# Same service-to-service bearer token as the Python backend's
# VALUATION_API_TOKEN (root .env) — sent as `Authorization: Bearer
# <token>` when this server proxies to /api/evaluate/{ticker}. Never
# exposed to the browser (no NEXT_PUBLIC_ prefix); the two copies must
# match exactly. Validated identically on both sides (format/placeholder/
# length only — not an entropy measurement; src/lib/secret-validation.ts
# here, src/api/main.py's VALUATION_API_TOKEN_MIN_LENGTH on the
# backend): must be set; not whitespace-only or whitespace-padded; not
# the placeholder value shown below; not a single character repeated;
# and at least 32 characters.
VALUATION_API_TOKEN=replace-with-a-long-random-value
